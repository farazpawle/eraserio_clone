# Supabase (self-hosted). The anon key is public by design; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Public site address, used for auth redirects behind the proxy (e.g. https://eraser.garritwulf.com).
SITE_URL=
